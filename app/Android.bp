package {
    default_applicable_licenses: ["Android-Apache-2.0"],
}

android_app {
    name: "Weather",

    srcs: [
        "src/main/java/**/*.kt",
        "src/main/java/**/*.java",
        "src/main/aidl/**/*.aidl",
        // Soong-only BuildConfig; AGP generates its own, gradle ignores src/soong.
        "src/soong/java/**/*.java",
    ],

    aidl: {
        local_include_dirs: ["src/main/aidl"],
    },

    resource_dirs: ["src/main/res"],

    manifest: "src/main/AndroidManifest.xml",

    // Built into FundamentalOS as a privileged system_ext app: platform-signed and
    // using platform APIs (no sdk_version) so the exported AIDL weather service and
    // its signature-level permission resolve against the platform.
    platform_apis: true,
    privileged: true,
    system_ext_specific: true,
    certificate: "platform",

    // The app targets Kotlin 2.3 under gradle, where kotlin.time.Clock/Instant are
    // stable; the tree kotlinc still gates them behind ExperimentalTime. gradle sets
    // no opt-in flag, so carry it here for the in-tree build.
    // -Xskip-metadata-version-check: com.kyant0:shapes 1.2.1 ships Kotlin 2.4.0
    // metadata; the tree kotlinc (2.2.0) reads up to 2.3.0, so let it read the newer
    // metadata rather than pinning an older shapes release.
    kotlincflags: [
        "-opt-in=kotlin.time.ExperimentalTime",
        "-Xskip-metadata-version-check",
    ],

    // @Parcelize (kotlinx.parcelize) backs the AIDL/IPC Parcelables. AGP applies the
    // kotlin-parcelize compiler plugin; generateBp does not carry that over, so turn
    // on the in-tree parcelize plugin here (compose is auto-applied by Soong, this is not).
    kotlin_plugins: ["kotlin-parcelize-compiler-plugin"],

    static_libs: [
        // DO NOT EDIT THIS SECTION MANUALLY
        "androidx.activity_activity-compose",
        "androidx.compose.animation_animation",
        "androidx.compose.animation_animation-core",
        "androidx.compose.foundation_foundation",
        "androidx.compose.foundation_foundation-layout",
        "androidx.compose.material_material-icons-core",
        "androidx.compose.material_material-icons-extended",
        "androidx.compose.material_material-ripple",
        "androidx.compose.material3_material3",
        "androidx.compose.material3_material3-ripple",
        "androidx.compose.runtime_runtime",
        "androidx.compose.runtime_runtime-annotation",
        "androidx.compose.runtime_runtime-retain",
        "androidx.compose.runtime_runtime-saveable",
        "androidx.compose.ui_ui",
        "androidx.compose.ui_ui-geometry",
        "androidx.compose.ui_ui-graphics",
        "androidx.compose.ui_ui-text",
        "androidx.compose.ui_ui-tooling-preview",
        "androidx.compose.ui_ui-unit",
        "androidx.compose.ui_ui-util",
        "androidx.core_core-ktx",
        "androidx.graphics_graphics-shapes",
        "androidx.lifecycle_lifecycle-runtime",
        "androidx.lifecycle_lifecycle-runtime-compose",
        "androidx.lifecycle_lifecycle-runtime-ktx",
        "androidx.lifecycle_lifecycle-viewmodel-compose",
        "androidx.lifecycle_lifecycle-viewmodel-savedstate",
        "androidx.navigation_navigation-common",
        "androidx.navigation_navigation-compose",
        "androidx.navigation_navigation-runtime",
        "androidx.navigation3_navigation3-runtime",
        "androidx.navigation3_navigation3-ui",
        "androidx.navigationevent_navigationevent",
        "androidx.navigationevent_navigationevent-compose",
        "androidx.savedstate_savedstate",
        "androidx.savedstate_savedstate-compose",
        "androidx.tracing_tracing",
        "androidx.window_window-core",
        "androidx.work_work-runtime-ktx",
        "com.google.accompanist_accompanist-permissions",
        "com.google.android.material_material",
        "dev.chrisbanes.haze_haze",
        "dev.chrisbanes.haze_haze-android",
        "dev.chrisbanes.haze_haze-materials",
        "dev.chrisbanes.haze_haze-materials-android",
        "io.github.fornewid_material-motion-compose-core",
        "io.github.fornewid_material-motion-compose-core-android",
        "io.github.kyant0_shapes",
        "io.github.kyant0_shapes-android",
        "io.insert-koin_koin-android",
        "io.insert-koin_koin-bom",
        "io.insert-koin_koin-compose",
        "io.insert-koin_koin-compose-android",
        "io.insert-koin_koin-compose-viewmodel",
        "io.insert-koin_koin-compose-viewmodel-android",
        "io.insert-koin_koin-compose-viewmodel-navigation",
        "io.insert-koin_koin-compose-viewmodel-navigation-android",
        "io.insert-koin_koin-core-viewmodel-android",
        "io.ktor_ktor-client-android",
        "io.ktor_ktor-client-content-negotiation",
        "io.ktor_ktor-client-encoding",
        "io.ktor_ktor-serialization-kotlinx-json",
        "org.jetbrains.compose.runtime_runtime-android",
        "org.jetbrains.compose.runtime_runtime-saveable-android",
        "org.jetbrains.compose.ui_ui-android",
        "org.jetbrains.compose.ui_ui-backhandler-android",
        "org.jetbrains.compose.ui_ui-geometry-android",
        "org.jetbrains.compose.ui_ui-graphics-android",
        "org.jetbrains.compose.ui_ui-text-android",
        "org.jetbrains.compose.ui_ui-unit-android",
        "org.jetbrains.compose.ui_ui-util-android",
        "kotlin-parcelize-runtime",
        "kotlin-stdlib",
        "kotlinx-coroutines-android",
        "org.jetbrains.kotlinx_kotlinx-datetime",
        "org.osmdroid_osmdroid-android",
    ],

    aaptflags: [
        // DO NOT EDIT THIS SECTION MANUALLY
        "--version-name",
        "0.1.1",
        "--version-code",
        "94",
    ],

    optimize: {
        proguard_flags_files: ["proguard-rules.pro"],
    },
}
